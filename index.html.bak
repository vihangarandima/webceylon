<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>WEB CEYLON — Bespoke Websites & Digital Architecture Worth Showing Off</title>
  <meta name="description" content="WEB CEYLON is a premier digital architecture studio in Colombo, crafting museum-grade bespoke websites, e-commerce engines, and high-performance web applications."/>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary-container": "#00422b",
            "primary": "#10b981",
            "primary-glow": "#4edea3",
            "on-background": "#e3e2e3",
            "surface-dim": "#121315",
            "surface": "#121315",
            "background": "#08090a",
            "secondary": "#d4af37",
            "secondary-container": "#af8d11",
            "tertiary": "#06b6d4",
            "surface-container-lowest": "#0d0e0f",
            "surface-container-low": "#1b1c1d",
            "surface-container": "#1f2021",
            "surface-container-high": "#292a2b",
            "surface-container-highest": "#343536",
            "on-surface": "#f4f4f5",
            "on-surface-variant": "#a1a1aa",
            "outline": "#86948a",
            "outline-variant": "#1f2328"
          },
          fontFamily: {
            "syne": ["Syne", "sans-serif"],
            "jakarta": ["Plus Jakarta Sans", "sans-serif"],
            "space": ["Space Grotesk", "monospace", "sans-serif"]
          },
          spacing: {
            "margin": "4rem",
            "margin-mobile": "1.25rem",
            "space-xs": "0.25rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "space-lg": "1.75rem",
            "space-xl": "3rem"
          }
        }
      }
    };
  </script>
  
  <!-- Fonts & Icons -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@300..700&family=Syne:wght@400..800&display=swap" rel="stylesheet"/>
  
  <!-- Custom Design System Stylesheet -->
  <link rel="stylesheet" href="css/main.css"/>
</head>

<body class="bg-[#08090a] font-jakarta text-[#e4e4e7] min-h-screen selection:bg-[#10b981] selection:text-[#08090a] antialiased">
  <div class="grain-overlay"></div>

  <!-- ================================================================= -->
  <!-- NAVIGATION HEADER                                                -->
  <!-- ================================================================= -->
  <header class="fixed top-0 left-0 w-full z-50 px-4 md:px-12 pt-4">
    <div class="h-16 max-w-[1680px] mx-auto bg-[#0d0e0f]/85 backdrop-blur-2xl rounded-full px-6 flex items-center justify-between border border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
      
      <!-- Brand Logo -->
      <a href="index.html" class="flex items-center gap-3">
        <img alt="WEB CEYLON Brandmark" class="h-8 w-auto object-contain" src="assets/brandmark.svg"/>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center gap-8">
        <a class="font-space text-xs uppercase tracking-widest text-[#10b981] font-semibold transition-colors hover:text-[#4edea3]" href="index.html">Selected Work</a>
        <a class="font-space text-xs uppercase tracking-widest text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors" href="case-studies.html">Case Studies</a>
        <a class="font-space text-xs uppercase tracking-widest text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors" href="services.html">Services & Estimator</a>
        <a class="font-space text-xs uppercase tracking-widest text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors" href="heritage-and-vision.html">Heritage & Vision</a>
        <a class="font-space text-xs uppercase tracking-widest text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors" href="process.html">Process</a>
        <a class="font-space text-xs uppercase tracking-widest text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors" href="contact.html">Contact</a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center gap-4">
        <!-- Live Colombo Time / Lang Indicator -->
        <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1c1d] border border-[#1f2328]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <span class="font-space text-[11px] tracking-wider text-[#a1a1aa] live-colombo-clock">[Live IST]</span>
        </div>

        <!-- Start a Project CTA Button -->
        <a class="hidden lg:inline-flex items-center gap-2 px-5 py-2 rounded-full btn-emerald font-space text-xs uppercase tracking-wider" href="contact.html">
          <span>Start a Project</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button id="mobileMenuBtn" class="xl:hidden w-10 h-10 rounded-full bg-[#1f2021] text-[#f4f4f5] flex items-center justify-center hover:bg-[#292a2b] transition-colors">
          <span class="material-symbols-outlined text-[22px]">menu</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Backdrop & Menu -->
  <div id="mobileDrawerBackdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50"></div>
  <div id="mobileDrawer" class="fixed top-0 right-0 h-full w-4/5 max-w-sm bg-[#0d0e0f] border-l border-[#1f2328] z-50 transform translate-x-full transition-transform duration-400 ease-in-out p-6 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between pb-8 border-b border-[#1f2328]">
        <img alt="WEB CEYLON Brandmark" class="h-7 w-auto" src="assets/brandmark.svg"/>
        <button id="closeMobileDrawer" class="w-9 h-9 rounded-full bg-[#1f2021] flex items-center justify-center text-[#a1a1aa] hover:text-white">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <nav class="flex flex-col space-y-5 pt-8 font-space text-sm uppercase tracking-widest">
        <a class="text-[#10b981] font-semibold" href="index.html">Selected Work</a>
        <a class="text-[#a1a1aa] hover:text-white transition-colors" href="case-studies.html">Case Studies</a>
        <a class="text-[#a1a1aa] hover:text-white transition-colors" href="services.html">Services & Estimator</a>
        <a class="text-[#a1a1aa] hover:text-white transition-colors" href="heritage-and-vision.html">Heritage & Vision</a>
        <a class="text-[#a1a1aa] hover:text-white transition-colors" href="process.html">Process</a>
        <a class="text-[#a1a1aa] hover:text-white transition-colors" href="contact.html">Contact</a>
      </nav>
    </div>

    <div class="space-y-4 pt-6 border-t border-[#1f2328]">
      <div class="font-space text-xs text-[#a1a1aa] flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
        <span>Colombo Studio • Available Q2/Q3</span>
      </div>
      <a href="contact.html" class="w-full py-3 rounded-xl btn-emerald flex items-center justify-center gap-2 font-space text-xs uppercase tracking-wider">
        <span>Commence Brief</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </div>

  <main class="w-full pt-20">
    <!-- Top Ambient Luster Glow -->
    <div class="relative w-full overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[850px] h-[340px] bg-gradient-to-b from-[#10b981]/15 via-[#10b981]/5 to-transparent blur-[120px] pointer-events-none -z-10"></div>
      
      <!-- ================================================================= -->
      <!-- 1. HERO SECTION                                                  -->
      <!-- ================================================================= -->
      <section class="max-w-[1680px] mx-auto w-full px-4 md:px-12 pt-8 md:pt-16">
        
        <!-- Eyebrow Meta Pill -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1c1d] border border-[#1f2328]">
            <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
            <span class="w-2 h-2 rounded-full bg-[#10b981] -ml-4"></span>
            <span class="font-space text-xs text-[#f4f4f5] uppercase tracking-widest pl-1">Web Ceylon — Studio Colombo</span>
          </div>
          <span class="text-[#3c4a42] select-none">/</span>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1f2021] border border-[#1f2328]">
            <span class="font-space text-xs text-[#10b981] tracking-widest uppercase">Digital Architecture</span>
            <span class="text-[#a1a1aa] font-space text-xs font-light select-none">|</span>
            <span class="font-jakarta text-xs text-[#f4f4f5] tracking-wider font-medium">ශ්‍රී ලංකා</span>
          </div>
          <div class="hidden lg:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1c1d] border border-[#1f2328] text-[#d4af37]">
            <span class="material-symbols-outlined text-[14px]">star</span>
            <span class="font-space text-xs tracking-wider uppercase">Awwwards Nominee 2025</span>
          </div>
        </div>

        <!-- Hero Colossal Headline -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-16">
          <div class="lg:col-span-8">
            <h1 class="font-syne text-5xl md:text-8xl lg:text-[96px] text-[#f4f4f5] font-extrabold tracking-tight leading-[0.95] select-none">
              We Build <br/>
              <span class="text-[#10b981] italic font-syne">Websites</span> Worth <br/>
              Showing Off.
            </h1>
          </div>
          <div class="lg:col-span-4 space-y-6 lg:pb-2">
            <p class="font-jakarta text-lg text-[#a1a1aa] leading-relaxed">
              Beautiful websites and bespoke digital systems engineered around ambitious global businesses. Made in Ceylon. Built for the world.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a class="inline-flex items-center gap-2 px-7 py-3 rounded-lg btn-emerald font-space text-xs uppercase tracking-wider font-bold" href="#selected-work">
                <span>Explore Our Work</span>
                <span class="material-symbols-outlined text-[18px]">south</span>
              </a>
              <a class="inline-flex items-center gap-2 px-7 py-3 rounded-lg btn-secondary font-space text-xs uppercase tracking-wider" href="contact.html">
                <span>Start a Project</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Monumental Viewport Anchor: Featured Project 01 (CarRents.lk in Minimal Browser Shell) -->
        <div class="relative w-full rounded-2xl bg-[#0d0e0f] p-2 md:p-4 border border-[#1f2328] shadow-2xl transition-all duration-700 group">
          <!-- Minimal Browser Glass Chrome -->
          <div class="h-10 md:h-12 w-full rounded-xl bg-[#1b1c1d] px-4 flex items-center justify-between gap-4 mb-2">
            <!-- Traffic Lights -->
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#ef4444]/70"></span>
              <span class="w-3 h-3 rounded-full bg-[#eab308]/70"></span>
              <span class="w-3 h-3 rounded-full bg-[#22c55e]/70"></span>
            </div>
            <!-- Centered Omnibar Capsule -->
            <div class="flex-1 max-w-xl h-7 md:h-8 rounded-full bg-[#292a2b] flex items-center justify-between px-4 text-[#a1a1aa]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[14px] text-[#10b981]">lock</span>
                <span class="font-space text-xs tracking-wider text-[#f4f4f5]">https://carrents.lk</span>
              </div>
              <div class="hidden sm:flex items-center gap-2 font-space text-[11px] text-[#10b981]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
                <span>LIVE PRODUCTION</span>
              </div>
            </div>
            <!-- Right Controls -->
            <div class="flex items-center gap-2 text-[#a1a1aa]">
              <button class="w-7 h-7 rounded bg-[#1f2021] flex items-center justify-center hover:text-white transition-colors" title="Reload Shell">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
              </button>
              <button class="hidden md:flex items-center gap-1 px-3 py-1 rounded bg-[#10b981]/15 text-[#10b981] hover:bg-[#10b981] hover:text-[#08090a] transition-all font-space text-xs uppercase" onclick="openCaseStudy('carrents')">
                <span class="material-symbols-outlined text-[14px]">tune</span>
                <span>Inspect Dossier</span>
              </button>
            </div>
          </div>

          <!-- Master Viewport Media Frame -->
          <div class="relative aspect-[16/10] md:aspect-[16/9] w-full overflow-hidden rounded-xl bg-[#1f2021]">
            <img alt="CarRents.lk luxury vehicle rental platform website designed and developed by WEB CEYLON" class="w-full h-full object-cover object-center group-hover:scale-[1.015] transition-transform duration-700 ease-out" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUHXzQ80mfW28ygd8hlbk2UcsLgAsg-C5jHa9UwPn9e_377clk9DhRth-br2reztmVG6pxU5xnOh2V-vc2TzrnPUWYEoCClZFdThhH4K2k79VFinGN8wUZLAC1vnm3eGQmJaXsf85ka9YcW5OsgiIwd36u1eNXreoGHuaqd3nk5Gvy_aMhqR3CvniooPGL3Zp49XzenlnIFqh5W9UaPfdL4MwtDyjP3GsvtXaPH3kwV5DKWsieKEsE"/>
            
            <!-- Overlaid Live Telemetry Pills -->
            <div class="absolute bottom-4 left-4 right-4 md:bottom-6 md:left-6 md:right-6 p-4 md:p-6 rounded-xl bg-[#0d0e0f]/85 backdrop-blur-xl border border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-2xl">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-space text-xs uppercase tracking-widest text-[#10b981]">Featured Client Release</span>
                  <span class="text-[#a1a1aa]">•</span>
                  <span class="font-space text-xs text-[#a1a1aa]">Automotive & Chauffeur Systems</span>
                </div>
                <h2 class="font-syne text-xl md:text-2xl text-[#f4f4f5] font-bold">CarRents.lk — The Premier Fleet Architecture of Sri Lanka</h2>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <div class="px-4 py-2 rounded-lg bg-[#1f2021] border border-[#1f2328] text-right">
                  <span class="block font-space text-[10px] text-[#a1a1aa] uppercase">Booking Conversion</span>
                  <span class="font-syne text-xl text-[#10b981] font-bold">+240%</span>
                </div>
                <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg btn-emerald font-space text-xs uppercase tracking-wider" onclick="openCaseStudy('carrents')">
                  <span>View Case Study</span>
                  <span class="material-symbols-outlined text-[16px]">visibility</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================================================= -->
      <!-- 2. INDUSTRY FILTER BAR & SELECTED WORK GALLERY                    -->
      <!-- ================================================================= -->
      <section class="max-w-[1680px] mx-auto w-full px-4 md:px-12 pt-24" id="selected-work">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-[#1f2328]">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
              <span class="font-space text-xs uppercase tracking-widest text-[#a1a1aa]">Index of Projects [01 — 05 Flagships]</span>
            </div>
            <h2 class="font-syne text-3xl md:text-5xl text-[#f4f4f5] font-bold tracking-tight">Curated Artifacts</h2>
          </div>
          <p class="font-jakarta text-sm md:text-base text-[#a1a1aa] max-w-sm">
            A showcase of bespoke e-commerce engines, web applications, and immersive websites manufactured with Sri Lankan precision.
          </p>
        </div>

        <!-- Filter Bar -->
        <div class="flex items-center gap-2 overflow-x-auto py-6 no-scrollbar">
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#10b981] text-[#08090a] font-space text-xs uppercase tracking-wider whitespace-nowrap font-bold" data-filter="all">All Projects (5)</button>
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#1f2021] text-[#a1a1aa] hover:text-[#f4f4f5] font-space text-xs uppercase tracking-wider whitespace-nowrap transition-colors" data-filter="automotive">Automotive & Logistics</button>
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#1f2021] text-[#a1a1aa] hover:text-[#f4f4f5] font-space text-xs uppercase tracking-wider whitespace-nowrap transition-colors" data-filter="ev-iot">Electric Vehicles & IoT</button>
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#1f2021] text-[#a1a1aa] hover:text-[#f4f4f5] font-space text-xs uppercase tracking-wider whitespace-nowrap transition-colors" data-filter="hospitality">Luxury Hospitality</button>
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#1f2021] text-[#a1a1aa] hover:text-[#f4f4f5] font-space text-xs uppercase tracking-wider whitespace-nowrap transition-colors" data-filter="ecommerce">E-Commerce & Retail</button>
          <button class="project-filter-btn px-5 py-2 rounded-full bg-[#1f2021] text-[#a1a1aa] hover:text-[#f4f4f5] font-space text-xs uppercase tracking-wider whitespace-nowrap transition-colors" data-filter="fintech">Custom Systems & FinTech</button>
        </div>

        <!-- GALLERY CONTAINER WITH ASYMMETRICAL EDITORIAL RHYTHM -->
        <div class="space-y-12">
          
          <!-- PROJECT 02: HIGH-TECH IoT PLATFORM (ChargeUp EV Ceylon) -->
          <div class="project-card" data-category="ev-iot">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center rounded-2xl bg-[#0d0e0f] p-6 md:p-10 border border-[#1f2328] shadow-xl">
              <!-- Left Narrative Column -->
              <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-3 py-1 rounded-full bg-[#06b6d4]/15 text-[#06b6d4] font-space text-xs uppercase tracking-widest font-semibold">IoT & Grid Telemetry</span>
                  <span class="px-3 py-1 rounded-full bg-[#1b1c1d] text-[#a1a1aa] font-space text-xs uppercase">React • Go • WebSockets</span>
                </div>
                <div>
                  <span class="font-space text-xs text-[#10b981] uppercase tracking-widest block mb-1">Project 02 / 05</span>
                  <h3 class="font-syne text-2xl md:text-4xl text-[#f4f4f5] font-bold tracking-tight">
                    ChargeUp EV Ceylon
                  </h3>
                  <p class="font-jakarta text-sm md:text-base text-[#a1a1aa] mt-3 leading-relaxed">
                    Nationwide real-time EV charging mesh and charging station router for Sri Lanka. Features sub-second telemetry, dynamic route optimization across the central highlands, and instant glassmorphic station metrics.
                  </p>
                </div>
                <!-- Spec Metric Grid -->
                <div class="grid grid-cols-3 gap-3 pt-2">
                  <div class="p-3 rounded-lg bg-[#1b1c1d] border border-[#1f2328]">
                    <span class="block font-space text-[10px] text-[#a1a1aa] uppercase">Grid Nodes</span>
                    <span class="font-syne text-xl text-[#f4f4f5] font-bold">140+</span>
                  </div>
                  <div class="p-3 rounded-lg bg-[#1b1c1d] border border-[#1f2328]">
                    <span class="block font-space text-[10px] text-[#a1a1aa] uppercase">Latency</span>
                    <span class="font-syne text-xl text-[#06b6d4] font-bold">&lt;85ms</span>
                  </div>
                  <div class="p-3 rounded-lg bg-[#1b1c1d] border border-[#1f2328]">
                    <span class="block font-space text-[10px] text-[#a1a1aa] uppercase">Uptime SLA</span>
                    <span class="font-syne text-xl text-[#10b981] font-bold">99.98%</span>
                  </div>
                </div>
                <div class="pt-2">
                  <button class="inline-flex items-center gap-2 text-[#10b981] font-space text-xs uppercase tracking-wider font-semibold hover:underline" onclick="openCaseStudy('chargeup')">
                    <span>Inspect Full Telemetry Dossier</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
                  </button>
                </div>
              </div>
              
              <!-- Right Visual Display (ChargeUp Curved Display Viewport) -->
              <div class="lg:col-span-7 order-1 lg:order-2">
                <div class="relative rounded-xl overflow-hidden bg-[#1f2021] border border-[#1f2328] shadow-2xl group/img">
                  <img alt="ChargeUp EV Ceylon curved monitor dashboard" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-700 ease-out" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDc2JCg2pZ431Wm-gcUI7Qq7CyeogBxzmLFi_d2bj7VvIJq66OzZhLvkN4A6jHNxWHOOohsBZDiAEjjwrU8GVkHut5STcYe8I6sJ-keXrO30hWSj0uyfL-sSNWLTgHouGVDRoPz-TQhX7O1u_PzLxaR-fO8AlR9kqxlgKTnq4JpM5Mz7jOHEfBf2ABuaNeKmmjm6xYZwi18gGs3wy6cB-yoHCY35azJuiq7XrVVaL2PH4IJ4lQSoYGp"/>
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0d0e0f]/80 via-transparent to-white/5 pointer-events-none"></div>
                  <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-[#0d0e0f]/90 backdrop-blur-md border border-[#1f2328] flex items-center gap-2 text-[#10b981] font-space text-xs">
                    <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
                    <span>LIVE SRI LANKA GRID MESH</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- PROJECTS 03 & 04: TWO-COLUMN ASYMMETRIC EDITORIAL GRID -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
            
            <!-- Project 03: Luxury Hospitality (Lanka Luxe Heritage) -->
            <div class="md:col-span-7 project-card" data-category="hospitality">
